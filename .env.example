PORT=5000
NODE_ENV=production
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=never
STORAGE_LIMIT_BYTES=524288000
# Comma-separated list of allowed CORS origins.
# Always include the Render host + Capacitor native WebView origins.
ALLOWED_ORIGINS=https://compressx-backend.onrender.com,capacitor://localhost,ionic://localhost,null
GEMINI_API_KEY=your_gemini_api_key_here
