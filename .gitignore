# ==============================================================================
#  Docholder / CompressX – Enterprise Master .gitignore
#  Covers: Node.js, Express Backend, Frontend Bundlers, Capacitor (Android & iOS),
#          SQLite/Databases, Native Binaries (Sharp/FFmpeg), Testing, IDEs & OS
# ==============================================================================

# ==============================================================================
# 1. ENVIRONMENT VARIABLES & SENSITIVE SECRETS
# ==============================================================================
.env
.env.*
!.env.example
!.env.test.example
backend/.env
backend/.env.*
!backend/.env.example
*.env
*.env.local
*.env.development
*.env.test
*.env.production
*.env.staging

# API Keys, Private Certificates & Keystores
*.pem
*.key
*.pub
*.cert
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
key.properties
android/key.properties
google-services.json
firebase-adminsdk*.json
serviceAccountKey.json
auth-secrets.json
secrets.json

# ==============================================================================
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# 3. BACKEND STORAGE, UPLOADS & FILE PROCESSING SCRATCH
# ==============================================================================
# Storage directories (keep directory structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/converted/*
!backend/storage/converted/.gitkeep
backend/storage/compressed/*
!backend/storage/compressed/.gitkeep
backend/storage/temp/*
!backend/storage/temp/.gitkeep
backend/storage/vault/*
!backend/storage/vault/.gitkeep
backend/temp/*
!backend/temp/.gitkeep
backend/converted/*
!backend/converted/.gitkeep
backend/processed/*
!backend/processed/.gitkeep

# Global Scratch & Temp folders
scratch/*
!scratch/.gitkeep
tmp/
temp/
.tmp/
.temp/
*.tmp

# ==============================================================================
# 4. DATABASES & LOCAL STORAGE ENGINES
# ==============================================================================
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
backend/*.db
backend/*.sqlite
backend/database/*.db
backend/database/*.sqlite
!backend/database/*.sql
!backend/database/*.schema.sql

# ==============================================================================
# 5. BUILD OUTPUTS & BUNDLERS (Frontend & Backend)
# ==============================================================================
dist/
build/
out/
.output/
.cache/
.parcel-cache/
.next/
.nuxt/
frontend/dist/
frontend/build/
frontend/.cache/
*.tsbuildinfo
*.js.map
*.css.map

# ==============================================================================
# 6. CAPACITOR & MOBILE PLATFORMS (Android & iOS)
# ==============================================================================
.capacitor/
capacitor.config.json.bak
capacitor.config.json.old

# Android Native Build Outputs & Cache
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/
android/local.properties
android/.cxx/
android/app/.cxx/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Android Artifacts & Binaries
*.apk
*.aab
*.ap_
*.dex
*.class
*.aar
*.so

# iOS Native Build Outputs & CocoaPods
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.dSYM.zip
*.dSYM
Pods/
DerivedData/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.xcuserstate

# ==============================================================================
# 7. NATIVE MODULE BINARIES (Sharp / FFmpeg / Canvas)
# ==============================================================================
**/sharp/build/
**/canvas/build/
**/ffmpeg-static/**/*.exe
**/ffmpeg-static/**/*.bin
**/ffmpeg-static/**/*.tar.gz
**/muhammara/build/

# ==============================================================================
# 8. TESTING, COVERAGE & DIAGNOSTICS
# ==============================================================================
coverage/
.nyc_output/
*.lcov
*.clover
reports/
playwright-report/
test-results/
backend/test_artifacts/
backend/test_output/
__tests__/__snapshots__/

# Runtime Process Locks & PID files
*.pid
*.seed
*.pid.lock

# ==============================================================================
# 9. LINTERS, FORMATTERS & TOOLING CACHE
# ==============================================================================
.eslintcache
.stylelintcache
.prettiercache
.terser-cache/

# ==============================================================================
# 10. IDEs, CODE EDITORS & SYSTEM TOOLS
# ==============================================================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains / IntelliJ / Android Studio / WebStorm
.idea/
*.iml
*.iws
*.ipr
*.idea/

# Sublime Text / Eclipse / NetBeans
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
.metadata/

# Vim / Nano / Emacs
*.swp
*.swo
*.sw?
*~
.#*
\#*\#

# ==============================================================================
# 11. OPERATING SYSTEM ARTIFACTS
# ==============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
.fuse_hidden*
.directory
.Trash-*

# ==============================================================================
# 12. AGENTIC & AI SCRATCH CACHES
# ==============================================================================
.agent/
.agents/scratch/
.system_generated/
